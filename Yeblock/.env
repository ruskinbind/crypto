#============DEV SETTINGS================
BASE_URL='https://www.yeblock.com/api'
ORIGIN='https://www.yeblock.com'
REFERER='https://www.yeblock.com/'

#seconds before expiry a token is treated as stale and refreshed
TOKEN_REFRESH_SKEW=60

#============YOUR SETTINGS================ true: on | false: off

#daily check-in
AUTO_CHECKIN=true

#hours to wait after the last check-in before checking in again
CHECKIN_COOLDOWN_HOURS=24

#skip check-in for accounts whose email is not verified
SKIP_UNVERIFIED_EMAIL=true

#show points/power in the profile line
SHOW_ASSETS=true

#Delay between requests (seconds)
DELAY_BETWEEN_REQUESTS=[1,5]

#Delay before starting each account (seconds)
DELAY_START_BOT=[1,10]

#minutes between cycles
TIME_SLEEP=360

# use proxy or not : true | false
USE_PROXY=false

#threads when using proxy
MAX_THEADS=50

#threads when not using proxy
MAX_THEADS_NO_PROXY=10
